# Copy to .env.local and fill in your own values (never commit .env.local).
# See README → "AI assistant (M5)".

# Required for the AI assistant (Runware-compatible API).
RUNWARE_API_KEY=

# Optional overrides:
# RUNWARE_BASE_URL=https://api.runware.ai/v1
# AI_MODEL=deepseek:v4@flash
# AI_MAX_TOKENS=8192

# Override the database location (default: data/personal-os.db, git-ignored).
# DATABASE_PATH=data/personal-os.db